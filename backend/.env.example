# Copy to backend/.env for local development. On Render, set these as environment variables.
GROQ_API_KEY=your_groq_api_key
# PostgreSQL with pgvector. Neon: use the DIRECT connection string (not the -pooler host) with sslmode=require.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-123.us-east-2.aws.neon.tech/neondb?sslmode=require
GROQ_MODEL=llama-3.3-70b-versatile
# Embeddings: auto (OpenAI if OPENAI_API_KEY is set, otherwise local FastEmbed), openai, or fastembed
EMBEDDER=auto
OPENAI_API_KEY=
DEFAULT_PDF_URL=https://phi-public.s3.amazonaws.com/recipes/ThaiRecipes.pdf
# Shared lifetime budget for paid calls (questions and document additions), across all users.
REQUEST_LIMIT=25
SESSION_TTL_DAYS=30
# Comma-separated browser origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:5173,https://paper-pilot-ss9w-ten.vercel.app
ENVIRONMENT=development
